{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medscout.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MedScout uses the microphone around pharmacy calls so you can dictate the outcome. Audio is transcribed on your device, never uploaded, and deleted after you log the result.",
        "NSSpeechRecognitionUsageDescription": "MedScout uses on-device speech recognition to log call results.",
        "NSLocationWhenInUseUsageDescription": "MedScout uses your location to find nearby pharmacies.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.medscout.app",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a1ec53f2-8dbc-4f55-976e-f78b7f88f9c5"
      }
    },
    "owner": "maniacalengineer"
  }
}
