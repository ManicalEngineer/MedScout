# Database — SQLite for dev, PostgreSQL for production
DATABASE_URL=sqlite:///./medscout.db
# DATABASE_URL=postgresql://user:password@localhost:5432/medscout

# JWT signing key — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Google Places API key — needed for nearby pharmacy discovery
# Get one at https://console.cloud.google.com → APIs & Services → Places API
GOOGLE_PLACES_API_KEY=

# OAuth sign-in — audience values for id_token verification.
# Google: the OAuth client ID from console.cloud.google.com → Credentials
# Apple: the app's bundle ID (native Sign in with Apple)
GOOGLE_OAUTH_CLIENT_ID=
APPLE_CLIENT_ID=com.medscout.app

# Browser origins allowed to call the API (comma-separated).
# The mobile app is unaffected; this is for the landing page / web tools.
# Production: set to the real landing page origin(s), e.g. https://getmedscout.com
CORS_ORIGINS=http://localhost:3000

# In-process daily job scheduler (refill/check-back reminders, FDA shortage
# ingestion). Not distributed-safe — if you run more than one API
# instance/worker, set this to "false" on all but one, or duplicate push
# notifications and FDA API calls will fire once per instance.
ENABLE_SCHEDULER=true
