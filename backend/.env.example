# Database — SQLite for dev, PostgreSQL for production
DATABASE_URL=sqlite:///./medscout.db
# DATABASE_URL=postgresql://user:password@localhost:5432/medscout

# JWT signing key — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Google Places API key — needed for nearby pharmacy discovery
# Get one at https://console.cloud.google.com → APIs & Services → Places API
GOOGLE_PLACES_API_KEY=
